fun formatMs(ms: Long): String {
    val sec = (ms / 1000).coerceAtLeast(0)
    return "%02d:%02d".format(sec / 60, sec % 60)
}

private fun encodeSanPathToJson(path: List<String>): String {
    val arr = org.json.JSONArray()
    path.forEach { arr.put(it) }
    return arr.toString()
}

