                                val res = withTimeoutOrNull(1500) {
                                    withContext(Dispatchers.IO) { countMatchesQuick(theme, lo, hi) }
                                }
                                withContext(Dispatchers.Main) {
                                    counting = false
                                    matchesNow = res ?: 0
                                }
                            }
                        }

