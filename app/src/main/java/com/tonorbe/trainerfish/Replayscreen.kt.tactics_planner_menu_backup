private fun shareTacticsSolvedText(
    context: Context,
    theme: String,
    rating: Int?,
    solvedMs: Long?,
    board: Array<Piece?>? = null,
    light: Color? = null,
    dark: Color? = null,
    pieceSetKey: String? = null
) {
